{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "description": "API de CoordinationFB, gestionnaire de collection de vinyles",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:init": "node src/db/init.js",
    "db:migrate": "node src/db/migrer.js",
    "flyway:migrate": "flyway -c flyway.config.cjs migrate",
    "flyway:info": "flyway -c flyway.config.cjs info",
    "flyway:validate": "flyway -c flyway.config.cjs validate",
    "flyway:baseline": "flyway -c flyway.config.cjs baseline",
    "flyway:clean": "flyway -c flyway.config.cjs clean",
    "test": "node --test",
    "lint": "eslint ."
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "node-flywaydb": "^3.0.7",
    "supertest": "^7.3.1"
  }
}
